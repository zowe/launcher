PROJECT="launcher"
# VERSION= used from manifest.yaml
DEPS="QUICKJS LIBYAML COMMON"
# <DEP>_BRANCH is the branch or tag to clone, <DEP>_COMMIT is the full commit SHA that gets built.
# The build fails if <DEP>_COMMIT is not a full SHA reachable from <DEP>_SOURCE, update both together.

QUICKJS="quickjs"
QUICKJS_SOURCE="git@github.com:zowe/quickjs-portable.git"
QUICKJS_BRANCH="staging"
QUICKJS_COMMIT="53ee9da0cd36a331207a0c3e3aa24b0ffd6c62fe"

LIBYAML="libyaml"
LIBYAML_SOURCE="git@github.com:yaml/libyaml.git"
LIBYAML_BRANCH="0.2.5"
LIBYAML_COMMIT="2c891fc7a770e8ba2fec34fc6b545c672beb37e6"

COMMON="common"
COMMON_SOURCE="git@github.com:zowe/zowe-common-c.git"
COMMON_BRANCH="v3.x/staging"
COMMON_COMMIT="107ce552a12f6400d7174a1bc5917ab3bf6c3779"
